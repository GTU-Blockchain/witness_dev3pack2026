# Witness ortak ortam değişkenleri. Gerçek değerleri .env dosyasına yaz, .env commit'lenmez.
# Gizli anahtarlar (Supabase service role, ElevenLabs) burada DEĞİL, Supabase secrets'ta durur.

# --- Solana (herkes) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Yedek RPC (devnet yavaşsa)
SOLANA_RPC_URL_FALLBACK=
# Program devnet'e deploy edildi (2026-11-26)
WITNESS_PROGRAM_ID=2CyjSQFX9pSJV7uTVG8UwvGxeDuRQyWZrfHMd8FZeeYJ
MEMO_PROGRAM_ID=MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr

# --- Mobil uygulama (/app) ---
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_WITNESS_PROGRAM_ID=2CyjSQFX9pSJV7uTVG8UwvGxeDuRQyWZrfHMd8FZeeYJ
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web doğrulama sitesi (Vercel) — MWA dApp identity domaini ile aynı
EXPO_PUBLIC_VERIFY_BASE_URL=https://web-pi-cyan-30.vercel.app
# Seeker Genesis Token mint adresi (henüz teyit edilmedi)
EXPO_PUBLIC_GENESIS_TOKEN_MINT=

# --- Web doğrulama (/web) ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_WITNESS_PROGRAM_ID=2CyjSQFX9pSJV7uTVG8UwvGxeDuRQyWZrfHMd8FZeeYJ
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

